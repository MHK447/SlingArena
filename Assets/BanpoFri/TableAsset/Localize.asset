    _ja: "<color=#00FF00>{0}</color>\u79D2\u3054\u3068\u306B\u6575\u3092\u7D20\u65E9\u304F\u653B\u6483\u3059\u308B\u30C8\u30A6\u30E2\u30ED\u30B3\u30B7\u3092\u751F\u6210\u3057\u307E\u3059\u3002"

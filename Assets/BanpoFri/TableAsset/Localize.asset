  - _idx: str_freecash_popup_benefit_context_1
    _ko: "\uD50C\uB808\uC774\uB9CC \uD574\uB3C4 \uBCF4\uC0C1\uC744 \uB4DC\uB824\uC694!"
    _en: Get rewards by playing!
    _ja: "\u30D7\u30EC\u30A4\u3057\u3066\u5831\u916C\u3092\u7372\u5F97!"
    _de: Erhalte Belohnungen durchs Spielen!
    _tw: "\u900F\u904E\u904A\u73A9\u7372\u5F97\u734E\u52F5!"
    _ru: "\u041F\u043E\u043B\u0443\u0447\u0430\u0439\u0442\u0435 \u043D\u0430\u0433\u0440\u0430\u0434\u044B
      \u0437\u0430 \u0438\u0433\u0440\u0443!"
    _fr: "Gagnez des r\xE9compenses en jouant!"
    _es: "\xA1Obt\xE9n recompensas jugando!"
    _vi: "Nh\u1EADn th\u01B0\u1EDFng b\u1EB1ng c\xE1ch ch\u01A1i!"
  - _idx: str_freecash_popup_benefit_context_2
    _ko: "\uAC00\uC785 \uC989\uC2DC $5\uB97C \uC801\uB9BD\uD574 \uB4DC\uB824\uC694!"
    _en: Sign up and instantly get $5!
    _ja: "\u767B\u9332\u3059\u308B\u3068\u3059\u3050\u306B5\u30C9\u30EB\u7372\u5F97!"
    _de: Melde dich an und erhalte sofort 5$!
    _tw: "\u8A3B\u518A\u7ACB\u5373\u7372\u5F975\u7F8E\u5143!"
    _ru: "\u0417\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u0443\u0439\u0442\u0435\u0441\u044C
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 $5 \u0441\u0440\u0430\u0437\u0443!"
    _fr: "Inscrivez-vous et obtenez 5$ instantan\xE9ment!"
    _es: "\xA1Reg\xEDstrate y obt\xE9n $5 al instante!"
    _vi: "\u0110\u0103ng k\xFD v\xE0 nh\u1EADn ngay $5!"
  - _idx: str_freecash_link_confirm
    _ko: "\uC5F0\uB3D9 \uD655\uC778"

    _ja: "<color=#00FF00>{0}</color>\u79D2\u3054\u3068\u306B\u6575\u3092\u3059\u3079\u3066\u62BC\u3057\u623B\u3059\u6B6F\u8ECA\u3092\u751F\u6210\u3057\u307E\u3059\u3002"

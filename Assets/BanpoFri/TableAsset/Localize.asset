    _ja: "\u5E83\u544A\u3092\u898B\u3066\u5831\u916C\u3092\u7372\u5F97\u3057\u307E\u3057\u3087\u3046"
    _de: Sieh dir eine Werbung an, um Belohnungen zu erhalten
    _tw: "\u89C0\u770B\u5EE3\u544A\u4EE5\u7372\u5F97\u734E\u52F5"
    _ru: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0440\u0435\u043A\u043B\u0430\u043C\u0443,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043D\u0430\u0433\u0440\u0430\u0434\u044B"
    _fr: "Regardez une publicit\xE9 pour obtenir des r\xE9compenses"

  - _idx: str_upgrade_choice_desc_4
    _ko: "\uCE58\uBA85\uD0C0 \uD655\uB960  <color=#37B700>+{0}%</color> \uC99D\uAC00"
    _en: Critical chance increases by <color=#37B700>+{0}%</color>.
    _ja: "\u30AF\u30EA\u30C6\u30A3\u30AB\u30EB\u78BA\u7387\u304C<color=#37B700>+{0}%</color>\u5897\u52A0\u3057\u307E\u3059\u3002"
    _de: "Die kritische Trefferchance erh\xF6ht sich um <color=#37B700>+{0}%</color>."
    _tw: "\u66B4\u64CA\u7387\u589E\u52A0<color=#37B700>+{0}%</color>\u3002"
    _ru: "\u0428\u0430\u043D\u0441 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0443\u0434\u0430\u0440\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 <color=#37B700>+{0}%</color>."

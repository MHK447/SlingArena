    _ja: "\u653B\u6483\u5BFE\u8C61\u306E\u6575\u304C<color=#37B700>1</color>\u5897\u52A0\u3057\u307E\u3059\u3002"
    _de: "Die Anzahl getroffener Gegner erh\xF6ht sich um <color=#37B700>1</color>."
    _tw: "\u53D7\u64CA\u6575\u4EBA\u6578\u91CF\u589E\u52A0<color=#37B700>1</color>\u3002"
    _ru: "\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043F\u043E\u0440\u0430\u0436\u0430\u0435\u043C\u044B\u0445
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 <color=#37B700>1</color>."
    _fr: "Le nombre d\u2019ennemis touch\xE9s augmente de <color=#37B700>1</color>."
    _es: "El n\xFAmero de enemigos alcanzados aumenta en <color=#37B700>1</color>."
    _vi: "S\u1ED1 l\u01B0\u1EE3ng k\u1EBB \u0111\u1ECBch b\u1ECB t\u1EA5n c\xF4ng
      t\u0103ng <color=#37B700>1</color>."
  - _idx: str_levelup_dice_desc_11_4
    _ko: "\uC801 HP <color=#37B700>{0}%</color> \uC774\uD558 \uC2DC \uC989\uC0AC"
    _en: Enemies die instantly when HP falls below <color=#37B700>{0}%</color>.
    _ja: "\u6575\u306EHP\u304C<color=#37B700>{0}%</color>\u4EE5\u4E0B\u306B\u306A\u308B\u3068\u5373\u6B7B\u3057\u307E\u3059\u3002"
    _de: Gegner sterben sofort, wenn ihre HP unter <color=#37B700>{0}%</color> fallen.
    _tw: "\u6575\u4EBAHP\u4F4E\u65BC<color=#37B700>{0}%</color>\u6642\u7ACB\u5373\u6B7B\u4EA1\u3002"
    _ru: "\u0412\u0440\u0430\u0433\u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E
      \u043F\u043E\u0433\u0438\u0431\u0430\u044E\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0438\u0445 HP \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0438\u0436\u0435
      <color=#37B700>{0}%</color>."
    _fr: "Les ennemis meurent instantan\xE9ment lorsque leurs PV tombent sous <color=#37B700>{0}%</color>."
    _es: "Los enemigos mueren instant\xE1neamente cuando su HP cae por debajo de
      <color=#37B700>{0}%</color>."
    _vi: "K\u1EBB \u0111\u1ECBch s\u1EBD ch\u1EBFt ngay khi HP d\u01B0\u1EDBi <color=#37B700>{0}%</color>."
  - _idx: str_levelup_dice_desc_12_1
    _ko: "\uBA54\uD14C\uC624 \uC8FC\uC0AC\uC704 +<color=#37B700>{0}</color>\uAC1C
      \\n \uC0DD\uC131 \uBAA9\uB85D\uC5D0 \uCD94\uAC00"
    _en: Meteor Dice +<color=#37B700>{0}</color> added\nAdded to spawn list
    _ja: "\u30E1\u30C6\u30AA\u30B5\u30A4\u30B3\u30ED +<color=#37B700>{0}</color>\u8FFD\u52A0\\n\u51FA\u73FE\u30EA\u30B9\u30C8\u306B\u8FFD\u52A0"
    _de: "Meteorw\xFCrfel +<color=#37B700>{0}</color> hinzugef\xFCgt\\nZur Spawnliste
      hinzugef\xFCgt"
    _tw: "\u9695\u77F3\u9AB0\u5B50 +<color=#37B700>{0}</color> \u65B0\u589E\\n\u5DF2\u52A0\u5165\u751F\u6210\u5217\u8868"
    _ru: "\u041A\u0443\u0431\u0438\u043A \u043C\u0435\u0442\u0435\u043E\u0440\u0430
      +<color=#37B700>{0}</color> \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\\n\u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E
      \u0432 \u0441\u043F\u0438\u0441\u043E\u043A \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F"
    _fr: "D\xE9 m\xE9t\xE9ore +<color=#37B700>{0}</color> ajout\xE9\\nAjout\xE9 \xE0
      la liste d\u2019apparition"
    _es: "Dado meteoro +<color=#37B700>{0}</color> a\xF1adido\\nA\xF1adido a la lista
      de aparici\xF3n"
    _vi: "Th\xEAm +<color=#37B700>{0}</color> x\xFAc x\u1EAFc thi\xEAn th\u1EA1ch\\n\u0110\xE3
      th\xEAm v\xE0o danh s\xE1ch xu\u1EA5t hi\u1EC7n"
  - _idx: str_levelup_dice_desc_12_2
    _ko: "\uC8FC\uC0AC\uC704 \uD53C\uD574\uB7C9 +<color=#37B700>{0}%</color>"
    _en: Dice damage increased by <color=#37B700>{0}%</color>.
    _ja: "\u30B5\u30A4\u30B3\u30ED\u30C0\u30E1\u30FC\u30B8\u304C<color=#37B700>{0}%</color>\u5897\u52A0\u3057\u307E\u3059\u3002"
    _de: "Der W\xFCrfelschaden erh\xF6ht sich um <color=#37B700>{0}%</color>."
    _tw: "\u9AB0\u5B50\u50B7\u5BB3\u589E\u52A0<color=#37B700>{0}%</color>\u3002"
    _ru: "\u0423\u0440\u043E\u043D \u043A\u0443\u0431\u0438\u043A\u043E\u0432 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 <color=#37B700>{0}%</color>."
    _fr: "Les d\xE9g\xE2ts des d\xE9s augmentent de <color=#37B700>{0}%</color>."
    _es: "El da\xF1o de los dados aumenta en <color=#37B700>{0}%</color>."
    _vi: "S\xE1t th\u01B0\u01A1ng x\xFAc x\u1EAFc t\u0103ng <color=#37B700>{0}%</color>."
  - _idx: str_levelup_dice_desc_12_3
    _ko: "\uBA54\uD14C\uC624 \uB300\uC0C1 +<color=#37B700>1</color>"
    _en: Meteor targets increased by <color=#37B700>1</color>.
    _ja: "\u30E1\u30C6\u30AA\u5BFE\u8C61\u304C<color=#37B700>1</color>\u5897\u52A0\u3057\u307E\u3059\u3002"
    _de: "Die Anzahl der Meteorziele erh\xF6ht sich um <color=#37B700>1</color>."
    _tw: "\u9695\u77F3\u76EE\u6A19\u589E\u52A0<color=#37B700>1</color>\u3002"
    _ru: "\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0446\u0435\u043B\u0435\u0439
      \u043C\u0435\u0442\u0435\u043E\u0440\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 <color=#37B700>1</color>."
    _fr: "Le nombre de cibles du m\xE9t\xE9ore augmente de <color=#37B700>1</color>."
    _es: Los objetivos del meteoro aumentan en <color=#37B700>1</color>.
    _vi: "S\u1ED1 m\u1EE5c ti\xEAu thi\xEAn th\u1EA1ch t\u0103ng <color=#37B700>1</color>."
  - _idx: str_levelup_dice_desc_12_4
    _ko: "\uBA54\uD14C\uC624 \uC801\uC911 \uC2DC \uD654\uC0C1"
    _en: Enemies hit by meteors are always burned.
    _ja: "\u30E1\u30C6\u30AA\u306B\u5F53\u305F\u3063\u305F\u6575\u306F\u5FC5\u305A\u706B\u50B7\u72B6\u614B\u306B\u306A\u308A\u307E\u3059\u3002"
    _de: Von Meteoren getroffene Gegner werden immer verbrannt.
    _tw: "\u88AB\u9695\u77F3\u64CA\u4E2D\u7684\u6575\u4EBA\u5FC5\u5B9A\u707C\u50B7\u3002"
    _ru: "\u0412\u0440\u0430\u0433\u0438, \u043F\u043E\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u0435
      \u043C\u0435\u0442\u0435\u043E\u0440\u043E\u043C, \u0432\u0441\u0435\u0433\u0434\u0430
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u043E\u0436\u043E\u0433."
    _fr: "Les ennemis touch\xE9s par des m\xE9t\xE9ores sont toujours br\xFBl\xE9s."
    _es: Los enemigos golpeados por meteoros siempre se queman.
    _vi: "K\u1EBB \u0111\u1ECBch tr\xFAng thi\xEAn th\u1EA1ch ch\u1EAFc ch\u1EAFn
      b\u1ECB thi\xEAu \u0111\u1ED1t."
  - _idx: str_levelup_dice_desc_13_1
    _ko: "\uC57D\uC790\uBA78\uC2DC \uC8FC\uC0AC\uC704 +<color=#37B700>{0}</color>\uAC1C
      \\n \uC0DD\uC131 \uBAA9\uB85D\uC5D0 \uCD94\uAC00"
    _en: Weak Slayer Dice +<color=#37B700>{0}</color> added\nAdded to spawn list
    _ja: "\u5F31\u8005\u6EC5\u8996\u30B5\u30A4\u30B3\u30ED +<color=#37B700>{0}</color>\u8FFD\u52A0\\n\u51FA\u73FE\u30EA\u30B9\u30C8\u306B\u8FFD\u52A0"
    _de: "Schw\xE4chlingsj\xE4ger-W\xFCrfel +<color=#37B700>{0}</color> hinzugef\xFCgt\\nZur
      Spawnliste hinzugef\xFCgt"
    _tw: "\u5F31\u8005\u8511\u8996\u9AB0\u5B50 +<color=#37B700>{0}</color> \u65B0\u589E\\n\u5DF2\u52A0\u5165\u751F\u6210\u5217\u8868"
    _ru: "\u041A\u0443\u0431\u0438\u043A \u0438\u0441\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044F
      \u0441\u043B\u0430\u0431\u044B\u0445 +<color=#37B700>{0}</color> \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\\n\u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E
      \u0432 \u0441\u043F\u0438\u0441\u043E\u043A \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u044F"
    _fr: "D\xE9 exterminateur des faibles +<color=#37B700>{0}</color> ajout\xE9\\nAjout\xE9
      \xE0 la liste d\u2019apparition"
    _es: "Dado exterminador de d\xE9biles +<color=#37B700>{0}</color> a\xF1adido\\nA\xF1adido
      a la lista de aparici\xF3n"
    _vi: "Th\xEAm +<color=#37B700>{0}</color> x\xFAc x\u1EAFc di\u1EC7t k\u1EBB y\u1EBFu\\n\u0110\xE3
      th\xEAm v\xE0o danh s\xE1ch xu\u1EA5t hi\u1EC7n"
  - _idx: str_levelup_dice_desc_13_2
    _ko: "\uC8FC\uC0AC\uC704 \uD53C\uD574\uB7C9 +<color=#37B700>{0}%</color>"
    _en: Dice damage increased by <color=#37B700>{0}%</color>.
    _ja: "\u30B5\u30A4\u30B3\u30ED\u30C0\u30E1\u30FC\u30B8\u304C<color=#37B700>{0}%</color>\u5897\u52A0\u3057\u307E\u3059\u3002"
    _de: "Der W\xFCrfelschaden erh\xF6ht sich um <color=#37B700>{0}%</color>."
    _tw: "\u9AB0\u5B50\u50B7\u5BB3\u589E\u52A0<color=#37B700>{0}%</color>\u3002"
    _ru: "\u0423\u0440\u043E\u043D \u043A\u0443\u0431\u0438\u043A\u043E\u0432 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 <color=#37B700>{0}%</color>."
    _fr: "Les d\xE9g\xE2ts des d\xE9s augmentent de <color=#37B700>{0}%</color>."
    _es: "El da\xF1o de los dados aumenta en <color=#37B700>{0}%</color>."
    _vi: "S\xE1t th\u01B0\u01A1ng x\xFAc x\u1EAFc t\u0103ng <color=#37B700>{0}%</color>."
  - _idx: str_levelup_dice_desc_13_3
    _ko: "\uC57D\uC790\uBA78\uC2DC \uCC98\uCE58 \uC2DC HP +<color=#37B700>{0}%</color>"
    _en: Recover <color=#37B700>{0}%</color> HP when defeating enemies with Weak
      Slayer attacks.
    _ja: "\u5F31\u8005\u6EC5\u8996\u653B\u6483\u3067\u6575\u3092\u5012\u3059\u3068HP\u3092<color=#37B700>{0}%</color>\u56DE\u5FA9\u3057\u307E\u3059\u3002"
    _de: "Stellt <color=#37B700>{0}%</color> HP wieder her, wenn Gegner mit Schw\xE4chlingsj\xE4ger-Angriffen
      besiegt werden."
    _tw: "\u4F7F\u7528\u5F31\u8005\u8511\u8996\u653B\u64CA\u64CA\u6557\u6575\u4EBA\u6642\u6062\u5FA9<color=#37B700>{0}%</color>HP\u3002"
    _ru: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      <color=#37B700>{0}%</color> HP \u043F\u0440\u0438 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0435
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0430\u0442\u0430\u043A\u043E\u0439 \u0438\u0441\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044F
      \u0441\u043B\u0430\u0431\u044B\u0445."
    _fr: "R\xE9cup\xE8re <color=#37B700>{0}%</color> de PV en \xE9liminant des ennemis
      avec une attaque exterminatrice."
    _es: Recupera <color=#37B700>{0}%</color> de HP al derrotar enemigos con ataques
      exterminadores.
    _vi: "H\u1ED3i <color=#37B700>{0}%</color> HP khi ti\xEAu di\u1EC7t k\u1EBB \u0111\u1ECBch
      b\u1EB1ng \u0111\xF2n di\u1EC7t k\u1EBB y\u1EBFu."
  - _idx: str_levelup_dice_desc_13_4
    _ko: "\uC57D\uC790\uBA78\uC2DC \uCC98\uCE58 \uC2DC \uCD94\uAC00 \uACF5\uACA9"
    _en: Attack once more after defeating enemies with Weak Slayer attacks.
    _ja: "\u5F31\u8005\u6EC5\u8996\u653B\u6483\u3067\u6575\u3092\u5012\u3059\u3068\u3082\u3046\u4E00\u5EA6\u653B\u6483\u3057\u307E\u3059\u3002"
    _de: "Greift erneut an, nachdem Gegner mit Schw\xE4chlingsj\xE4ger-Angriffen
      besiegt wurden."
    _tw: "\u4F7F\u7528\u5F31\u8005\u8511\u8996\u653B\u64CA\u64CA\u6557\u6575\u4EBA\u5F8C\u518D\u6B21\u653B\u64CA\u3002"
    _ru: "\u0410\u0442\u0430\u043A\u0443\u0435\u0442 \u0435\u0449\u0451 \u0440\u0430\u0437
      \u043F\u043E\u0441\u043B\u0435 \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430
      \u0432\u0440\u0430\u0433\u0430 \u0430\u0442\u0430\u043A\u043E\u0439 \u0438\u0441\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044F
      \u0441\u043B\u0430\u0431\u044B\u0445."
    _fr: "Attaque une nouvelle fois apr\xE8s avoir \xE9limin\xE9 un ennemi avec une
      attaque exterminatrice."
    _es: "Ataca una vez m\xE1s despu\xE9s de derrotar enemigos con ataques exterminadores."
    _vi: "T\u1EA5n c\xF4ng th\xEAm m\u1ED9t l\u1EA7n sau khi ti\xEAu di\u1EC7t k\u1EBB
      \u0111\u1ECBch b\u1EB1ng \u0111\xF2n di\u1EC7t k\u1EBB y\u1EBFu."
  - _idx: str_levelup_dice_desc_101
    _ko: HP +<color=#37B700>{0}%</color>
    _en: Recover <color=#37B700>{0}%</color> HP.
    _ja: "HP\u3092<color=#37B700>{0}%</color>\u56DE\u5FA9\u3057\u307E\u3059\u3002"
    _de: Stellt <color=#37B700>{0}%</color> HP wieder her.
    _tw: "\u6062\u5FA9<color=#37B700>{0}%</color>HP\u3002"
    _ru: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      <color=#37B700>{0}%</color> HP."
    _fr: "R\xE9cup\xE8re <color=#37B700>{0}%</color> de PV."
    _es: Recupera <color=#37B700>{0}%</color> de HP.
    _vi: "H\u1ED3i <color=#37B700>{0}%</color> HP."
  - _idx: str_levelup_dice_desc_102
    _ko: "\uBCF4\uAE09 \uC8FC\uC0AC\uC704 +<color=#37B700>{0}</color>\uAC1C \uCD94\uAC00"
    _en: Supply Dice +<color=#37B700>{0}</color> added
    _ja: "\u88DC\u7D66\u30B5\u30A4\u30B3\u30ED +<color=#37B700>{0}</color>\u8FFD\u52A0"
    _de: "Versorgungsw\xFCrfel +<color=#37B700>{0}</color> hinzugef\xFCgt"
    _tw: "\u88DC\u7D66\u9AB0\u5B50 +<color=#37B700>{0}</color> \u65B0\u589E"
    _ru: "\u041A\u0443\u0431\u0438\u043A \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F
      +<color=#37B700>{0}</color> \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D"
    _fr: "D\xE9 de ravitaillement +<color=#37B700>{0}</color> ajout\xE9"
    _es: "Dado de suministro +<color=#37B700>{0}</color> a\xF1adido"
    _vi: "Th\xEAm +<color=#37B700>{0}</color> x\xFAc x\u1EAFc ti\u1EBFp t\u1EBF"
  - _idx: str_levelup_dice_desc_103
    _ko: "\uC6E8\uC774\uBE0C \uC2DC\uC791 \uC2DC \uC8FC\uC0AC\uC704 +<color=#37B700>{0}</color>\uAC1C"
    _en: Add +<color=#37B700>{0}</color> Dice at the start of a wave.
    _ja: "\u30A6\u30A7\u30FC\u30D6\u958B\u59CB\u6642\u3001\u30B5\u30A4\u30B3\u30ED\u3092+<color=#37B700>{0}</color>\u8FFD\u52A0\u3057\u307E\u3059\u3002"
    _de: "F\xFCgt zu Beginn einer Welle +<color=#37B700>{0}</color> W\xFCrfel hinzu."
    _tw: "\u6CE2\u6B21\u958B\u59CB\u6642\u589E\u52A0 +<color=#37B700>{0}</color>
      \u9AB0\u5B50\u3002"
    _ru: "\u0414\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 +<color=#37B700>{0}</color>
      \u043A\u0443\u0431\u0438\u043A\u043E\u0432 \u0432 \u043D\u0430\u0447\u0430\u043B\u0435
      \u0432\u043E\u043B\u043D\u044B."
    _fr: "Ajoute +<color=#37B700>{0}</color> d\xE9s au d\xE9but d\u2019une vague."
    _es: "A\xF1ade +<color=#37B700>{0}</color> dados al inicio de una oleada."
    _vi: "Th\xEAm +<color=#37B700>{0}</color> x\xFAc x\u1EAFc khi b\u1EAFt \u0111\u1EA7u
      \u0111\u1EE3t."
  - _idx: str_levelup_dice_desc_104
    _ko: "\uACF5\uACA9\uD134 \uC2DC\uC791 \uC2DC \uD589\uC6B4 \uC8FC\uC0AC\uC704
      \uD655\uB960 \uB4F1\uC7A5"
    _en: Chance for Lucky Dice to appear at the start of the attack turn.
    _ja: "\u653B\u6483\u30BF\u30FC\u30F3\u958B\u59CB\u6642\u306B\u5E78\u904B\u30B5\u30A4\u30B3\u30ED\u304C\u51FA\u73FE\u3059\u308B\u78BA\u7387\u3002"
    _de: "Chance auf das Erscheinen eines Gl\xFCcksw\xFCrfels zu Beginn des Angriffszugs."
    _tw: "\u653B\u64CA\u56DE\u5408\u958B\u59CB\u6642\u6709\u6A5F\u7387\u51FA\u73FE\u5E78\u904B\u9AB0\u5B50\u3002"

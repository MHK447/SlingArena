    _vi: "\xC1p d\u1EE5ng gi\u1EA3m gi\xE1 VIP khi mua qu\u1EA3ng c\xE1o b\u1EAFt
      bu\u1ED9c!"
  - _idx: all_ingmae_vip_desc_1
    _ko: "\uC704 \uC7AC\uD654\uAC00 \uBCF4\uB108\uC2A4\uB85C \uC9C0\uAE09\uB429\uB2C8\uB2E4!"

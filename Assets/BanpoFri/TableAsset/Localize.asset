    _de: "Erzeugt +{0} zus\xE4tzliche W\xFCrfel."
    _tw: "\u984D\u5916\u751F\u6210+{0}\u500B\u9AB0\u5B50\u3002"
    _ru: "\u0421\u043E\u0437\u0434\u0430\u0451\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E

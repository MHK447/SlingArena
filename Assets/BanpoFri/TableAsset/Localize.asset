    _ja: "\u4F53\u529B\u3092<color=#37B700>{0}%</color>\u56DE\u5FA9\u3057\u307E\u3059\u3002"
    _de: Stellt <color=#37B700>{0}%</color> Gesundheit wieder her.
    _tw: "\u6062\u5FA9<color=#37B700>{0}%</color>\u751F\u547D\u503C\u3002"
    _ru: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      <color=#37B700>{0}%</color> \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."

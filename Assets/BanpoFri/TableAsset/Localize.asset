    _de: Verursacht Verbrennung beim Angriff
    _tw: "\u653B\u64CA\u6642\u9020\u6210\u71C3\u71D2"
    _ru: "\u041D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043E\u0436\u043E\u0433
      \u043F\u0440\u0438 \u0430\u0442\u0430\u043A\u0435"

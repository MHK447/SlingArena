  - _idx: str_desc_getreward
    _ko: "\uBCF4\uC0C1\uC744 \uBAA8\uB450 \uBC1B\uC558\uC2B5\uB2C8\uB2E4!"
    _en: Obtained all rewards!
    _ja: "\u3059\u3079\u3066\u306E\u5831\u916C\u3092\u7372\u5F97\uFF01"
    _de: Alle Belohnungen erhalten!
    _tw: "\u5DF2\u7372\u5F97\u6240\u6709\u734E\u52F5\uFF01"
    _ru: "\u0412\u0441\u0435 \u043D\u0430\u0433\u0440\u0430\u0434\u044B \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u044B!"
    _fr: "Toutes les r\xE9compenses obtenues !"
    _es: "\xA1Has obtenido todas las recompensas!"
    _vi: "\u0110\xE3 nh\u1EADn t\u1EA5t c\u1EA3 ph\u1EA7n th\u01B0\u1EDFng!"
  - _idx: str_name_reward_6_3
    _ko: "\uC6A9\uBE44\uB298"
    _en: Dragon Scale
    _ja: "\u30C9\u30E9\u30B4\u30F3\u30B9\u30B1\u30FC\u30EB"
    _de: Drachenschuppe
    _tw: "\u9F8D\u9C57"
    _ru: "\u0414\u0440\u0430\u043A\u043E\u043D\u044C\u044F \u0447\u0435\u0448\u0443\u044F"
    _fr: "\xC9caille de dragon"
    _es: "Escama de drag\xF3n"
    _vi: "V\u1EA3y R\u1ED3ng"
  - _idx: str_desc_reward_6_3
    _ko: "\uBAA8\uC544\uC11C \uC774\uBCA4\uD2B8 \uBCF4\uC0C1\uC744 \uBC1B\uC744 \uC218
      \uC788\uC2B5\uB2C8\uB2E4!"
    _en: Collect dragon scales to claim event rewards!
    _ja: "\u30C9\u30E9\u30B4\u30F3\u30B9\u30B1\u30FC\u30EB\u3092\u96C6\u3081\u3066\u30A4\u30D9\u30F3\u30C8\u5831\u916C\u3092\u7372\u5F97\uFF01"
    _de: Sammle Drachenschuppen, um Event-Belohnungen zu erhalten!
    _tw: "\u6536\u96C6\u9F8D\u9C57\u4EE5\u7372\u5F97\u6D3B\u52D5\u734E\u52F5\uFF01"
    _ru: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0447\u0435\u0448\u0443\u044E
      \u0434\u0440\u0430\u043A\u043E\u043D\u0430, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u044B
      \u0441\u043E\u0431\u044B\u0442\u0438\u044F!"
    _fr: "Collectez des \xE9cailles de dragon pour obtenir des r\xE9compenses !"
    _es: "\xA1Recoge escamas de drag\xF3n para reclamar recompensas!"
    _vi: "Thu th\u1EADp V\u1EA3y R\u1ED3ng \u0111\u1EC3 nh\u1EADn ph\u1EA7n th\u01B0\u1EDFng
      s\u1EF1 ki\u1EC7n!"
  - _idx: str_name_reward_6_2
    _ko: "\uC774\uBCA4\uD2B8 \uC7AC\uD654 \uD68D\uB4DD\uB7C9 2\uBC30!"
    _en: 2x Event Currency Gain!
    _ja: "\u30A4\u30D9\u30F3\u30C8\u901A\u8CA82\u500D\u7372\u5F97\uFF01"
    _de: "2x Event-W\xE4hrung!"
    _tw: "\u6D3B\u52D5\u8CA8\u5E632\u500D\u7372\u5F97\uFF01"
    _ru: "2x \u0432\u0430\u043B\u044E\u0442\u044B \u0441\u043E\u0431\u044B\u0442\u0438\u044F
      !"
    _fr: "Gain x2 de monnaie d\u2019\xE9v\xE9nement !"
    _es: "\xA1Doble moneda del evento!"
    _vi: "Nh\u1EADn g\u1EA5p \u0111\xF4i ti\u1EC1n s\u1EF1 ki\u1EC7n!"
  - _idx: str_desc_reward_6_2
    _ko: "\uC774\uBCA4\uD2B8\uC5D0\uC11C \uC7AC\uD654\uB97C \uD68D\uB4DD\uD558\uB294
      \uC591\uC744 2\uBC30 \uB298\uB824\uC90D\uB2C8\uB2E4."
    _en: Doubles the amount of event currency earned.
    _ja: "\u30A4\u30D9\u30F3\u30C8\u901A\u8CA8\u306E\u7372\u5F97\u91CF\u304C2\u500D\u306B\u306A\u308A\u307E\u3059\u3002"
    _de: "Verdoppelt die erhaltene Event-W\xE4hrung."

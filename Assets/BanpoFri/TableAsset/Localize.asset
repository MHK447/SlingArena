    _es: Ataca dos veces con una probabilidad de <color=#37B700>{0}%</color>.
    _vi: "C\xF3 <color=#37B700>{0}%</color> c\u01A1 h\u1ED9i t\u1EA5n c\xF4ng hai
      l\u1EA7n."
  - _idx: str_upgrade_choice_desc_102
    _ko: "\uD654\uC0B4 {0}\uD68C \uD295\uAE40"

      angreift.
    _tw: "\u6BCF <color=#00FF00>{0}</color> \u79D2\u751F\u6210\u5FEB\u901F\u653B\u64CA\u6575\u4EBA\u7684\u7389\u7C73\u3002"
    _ru: "\u041A\u0430\u0436\u0434\u044B\u0435 <color=#00FF00>{0}</color> \u0441\u0435\u043A.

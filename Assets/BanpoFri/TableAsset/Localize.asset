    _de: "Der Angriff erh\xF6ht sich in der n\xE4chsten Welle um <color=#37B700>+{0}%</color>."
    _tw: "\u4E0B\u4E00\u6CE2\u653B\u64CA\u529B\u589E\u52A0<color=#37B700>+{0}%</color>\u3002"
    _ru: "\u0410\u0442\u0430\u043A\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 <color=#37B700>+{0}%</color> \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0432\u043E\u043B\u043D\u0435."

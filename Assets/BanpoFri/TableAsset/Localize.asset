    _tw: "\u6BCF <color=#00FF00>{0}</color> \u79D2\u751F\u6210\u51CD\u7D50\u6575\u4EBA\u7684\u51B0\u7403\u3002"
    _ru: "\u041A\u0430\u0436\u0434\u044B\u0435 <color=#00FF00>{0}</color> \u0441\u0435\u043A.

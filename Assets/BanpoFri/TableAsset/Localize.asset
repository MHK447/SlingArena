  - _idx: str_rank_player_next_level_1
    _ko: "\uB9C8\uBC95 \uBAA8\uC790 <color=#4BEA34>{0}</color>\uAC1C \uD68D\uB4DD
      \uC2DC <color=#EDF055>\uB2E4\uC74C \uBCF4\uC0C1 \uAD6C\uAC04</color>\uC73C\uB85C
      \uC774\uB3D9"
    _en: Collect <color=#4BEA34>{0}</color> Dragon Scales to progress to the <color=#EDF055>next
      reward tier</color>.
    _ja: "<color=#4BEA34>{0}</color>\u500B\u306E\u30C9\u30E9\u30B4\u30F3\u30B9\u30B1\u30FC\u30EB\u3092\u96C6\u3081\u3066<color=#EDF055>\u6B21\u306E\u5831\u916C\u6BB5\u968E</color>\u3078\u9032\u3082\u3046\u3002"
    _de: "Sammle <color=#4BEA34>{0}</color> Drachenschuppen, um die <color=#EDF055>n\xE4chste
      Belohnungsstufe</color> zu erreichen."
    _tw: "\u6536\u96C6<color=#4BEA34>{0}</color>\u500B\u9F8D\u9C57\u4EE5\u6649\u7D1A\u81F3<color=#EDF055>\u4E0B\u4E00\u734E\u52F5\u968E\u6BB5</color>\u3002"
    _ru: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 <color=#4BEA34>{0}</color>
      \u0447\u0435\u0448\u0443\u0435\u043A \u0434\u0440\u0430\u043A\u043E\u043D\u0430,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u043A
      <color=#EDF055>\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u0443\u0440\u043E\u0432\u043D\u044E \u043D\u0430\u0433\u0440\u0430\u0434\u044B</color>."
    _fr: "Collectez <color=#4BEA34>{0}</color> \xE9cailles de dragon pour atteindre
      le <color=#EDF055>niveau de r\xE9compense suivant</color>."
    _es: Recolecta <color=#4BEA34>{0}</color> escamas para avanzar al <color=#EDF055>siguiente
      nivel de recompensa</color>.
    _vi: "Thu th\u1EADp <color=#4BEA34>{0}</color> V\u1EA3y R\u1ED3ng \u0111\u1EC3
      ti\u1EBFn t\u1EDBi <color=#EDF055>m\u1ED1c ph\u1EA7n th\u01B0\u1EDFng ti\u1EBFp
      theo</color>."
  - _idx: str_rank_player_next_level_2
    _ko: "\uB124\uC78E \uD074\uB85C\uBC84 <color=#4BEA34>{0}</color>\uAC1C \uD68D\uB4DD
      \uC2DC <color=#EDF055>\uB2E4\uC74C \uBCF4\uC0C1 \uAD6C\uAC04</color>\uC73C\uB85C
      \uC774\uB3D9"
    _en: Collect <color=#4BEA34>{0}</color> Four-leaf Clovers to move to the <color=#EDF055>next
      reward tier</color>.
    _ja: "\u56DB\u3064\u8449\u306E\u30AF\u30ED\u30FC\u30D0\u30FC\u3092<color=#4BEA34>{0}</color>\u500B\u96C6\u3081\u308B\u3068\u3001<color=#EDF055>\u6B21\u306E\u5831\u916C\u6BB5\u968E</color>\u306B\u9032\u307F\u307E\u3059\u3002"
    _de: "Sammle <color=#4BEA34>{0}</color> vierbl\xE4ttrige Kleebl\xE4tter, um zur
      <color=#EDF055>n\xE4chsten Belohnungsstufe</color> zu gelangen."
    _tw: "\u6536\u96C6<color=#4BEA34>{0}</color>\u500B\u56DB\u8449\u5E78\u904B\u8349\u5373\u53EF\u9032\u5165<color=#EDF055>\u4E0B\u4E00\u500B\u734E\u52F5\u968E\u6BB5</color>\u3002"
    _ru: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 <color=#4BEA34>{0}</color>
      \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u043B\u0438\u0441\u0442\u043D\u044B\u0445
      \u043A\u043B\u0435\u0432\u0435\u0440\u043E\u0432, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u043A <color=#EDF055>\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u0443\u0440\u043E\u0432\u043D\u044E \u043D\u0430\u0433\u0440\u0430\u0434</color>."
    _fr: "Collectez <color=#4BEA34>{0}</color> tr\xE8fles \xE0 quatre feuilles pour
      passer au <color=#EDF055>niveau de r\xE9compense suivant</color>."
    _es: "Recolecta <color=#4BEA34>{0}</color> tr\xE9boles de cuatro hojas para pasar
      al <color=#EDF055>siguiente nivel de recompensa</color>."
    _vi: "Thu th\u1EADp <color=#4BEA34>{0}</color> c\u1ECF b\u1ED1n l\xE1 \u0111\u1EC3
      chuy\u1EC3n sang <color=#EDF055>m\u1ED1c ph\u1EA7n th\u01B0\u1EDFng ti\u1EBFp
      theo</color>."
  - _idx: str_rank_player_next_level_3
    _ko: "\uCC9C\uC0AC \uB0A0\uAC1C <color=#4BEA34>{0}</color>\uAC1C \uD68D\uB4DD

  - _idx: str_insufficient_ads_desc
    _ko: "\uAD11\uACE0\uB97C \uC2DC\uCCAD\uD558\uACE0 \uBCF4\uC0C1\uC744 \uD68D\uB4DD\uD558\uC138\uC694"

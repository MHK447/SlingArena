    _tw: "\u6700\u5927\u751F\u547D\u503C\u589E\u52A0<color=#37B700>+{0}%</color>\u3002"
    _ru: "\u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 <color=#37B700>+{0}%</color>."

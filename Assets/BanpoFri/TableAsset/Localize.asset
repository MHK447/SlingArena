    _es: Ver enlace
    _vi: "Ki\u1EC3m tra li\xEAn k\u1EBFt"
  - _idx: str_freecash_popup_button
    _ko: "\uACC4\uC815 \uC5F0\uACB0\uD558\uACE0 \uBCF4\uC0C1\uBC1B\uAE30"
    _en: Link your account to get rewards!
    _ja: "\u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u9023\u643A\u3057\u3066\u5831\u916C\u3092\u7372\u5F97!"
    _de: "Konto verkn\xFCpfen und Belohnungen erhalten!"
    _tw: "\u9023\u7D50\u5E33\u865F\u4EE5\u7372\u5F97\u734E\u52F5!"
    _ru: "\u0421\u0432\u044F\u0436\u0438\u0442\u0435 \u0430\u043A\u043A\u0430\u0443\u043D\u0442,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043D\u0430\u0433\u0440\u0430\u0434\u044B!"
    _fr: "Liez votre compte pour obtenir des r\xE9compenses!"
    _es: "\xA1Vincula tu cuenta para obtener recompensas!"
    _vi: "Li\xEAn k\u1EBFt t\xE0i kho\u1EA3n \u0111\u1EC3 nh\u1EADn th\u01B0\u1EDFng!"
  - _idx: str_freecash_popup_context
    _ko: "\uD504\uB9AC\uCE90\uC2DC \uACC4\uC815\uC744 \uC5F0\uACB0\uD558\uACE0 \uC2E4\uC81C
      \uC218\uC775\uC744 \uCC3D\uCD9C\uD558\uC138\uC694\\n \uD50C\uB808\uC774\uB9CC
      \uD574\uB3C4 \uBCF4\uC0C1\uC744 \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694!"
    _en: Link your Freecash account and earn real profit!\nReceive rewards just by
      playing.
    _ja: "Freecash\u30A2\u30AB\u30A6\u30F3\u30C8\u3092\u9023\u643A\u3057\u3066\u5B9F\u969B\u306E\u5831\u916C\u3092\u7372\u5F97!\\n\u30D7\u30EC\u30A4\u3059\u308B\u3060\u3051\u3067\u5831\u916C\u304C\u3082\u3089\u3048\u307E\u3059."
    _de: "Verkn\xFCpfe dein Freecash-Konto und verdiene echten Gewinn!\\nErhalte
      Belohnungen einfach durchs Spielen."
    _tw: "\u9023\u7D50\u60A8\u7684 Freecash \u5E33\u865F\u4E26\u7372\u5F97\u771F\u5BE6\u6536\u76CA!\\n\u53EA\u9700\u904A\u73A9\u5373\u53EF\u7372\u5F97\u734E\u52F5."
    _ru: "\u0421\u0432\u044F\u0436\u0438\u0442\u0435 \u0441\u0432\u043E\u0439 \u0430\u043A\u043A\u0430\u0443\u043D\u0442
      Freecash \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0439\u0442\u0435 \u0440\u0435\u0430\u043B\u044C\u043D\u0443\u044E
      \u043F\u0440\u0438\u0431\u044B\u043B\u044C!\\n\u041F\u043E\u043B\u0443\u0447\u0430\u0439\u0442\u0435
      \u043D\u0430\u0433\u0440\u0430\u0434\u044B \u043F\u0440\u043E\u0441\u0442\u043E
      \u0438\u0433\u0440\u0430\u044F."
    _fr: "Liez votre compte Freecash et gagnez de vrais profits!\\nRecevez des r\xE9compenses
      simplement en jouant."
    _es: "\xA1Vincula tu cuenta de Freecash y gana dinero real!\\nRecibe recompensas
      solo por jugar."
    _vi: "Li\xEAn k\u1EBFt t\xE0i kho\u1EA3n Freecash v\xE0 ki\u1EBFm l\u1EE3i nhu\u1EADn
      th\u1EADt!\\nNh\u1EADn th\u01B0\u1EDFng ch\u1EC9 b\u1EB1ng c\xE1ch ch\u01A1i."
  - _idx: str_freecash_link_toast_1
    _ko: "\uC5F0\uB3D9 \uD655\uC778\uC774 \uC644\uB8CC\uB410\uC2B5\uB2C8\uB2E4!"
    _en: Link complete!
    _ja: "\u30EA\u30F3\u30AF\u5B8C\u4E86!"
    _de: "Verkn\xFCpfung abgeschlossen!"
    _tw: "\u9023\u7D50\u5B8C\u6210!"

    _vi: "Ph\xF2ng th\u1EE7 t\u0103ng <color=#37B700>+{0}%</color>."
  - _idx: str_upgrade_choice_desc_101
    _ko: "<color=#37B700>{0}%</color> \uD655\uB960\uB85C \uB450\uBC88 \uACF5\uACA9"
    _en: Attacks twice with a <color=#37B700>{0}%</color> chance.
    _ja: "<color=#37B700>{0}%</color>\u306E\u78BA\u7387\u30672\u56DE\u653B\u6483\u3057\u307E\u3059\u3002"
    _de: Greift mit einer Wahrscheinlichkeit von <color=#37B700>{0}%</color> zweimal
      an.
    _tw: "\u6709<color=#37B700>{0}%</color>\u6A5F\u7387\u9032\u884C\u96D9\u91CD\u653B\u64CA\u3002"
    _ru: "\u0421 \u0448\u0430\u043D\u0441\u043E\u043C <color=#37B700>{0}%</color>
      \u0430\u0442\u0430\u043A\u0443\u0435\u0442 \u0434\u0432\u0430\u0436\u0434\u044B."

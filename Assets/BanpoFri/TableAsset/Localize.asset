  - _idx: hero_desc_1
    _ko: "\uD654\uC0B4\uB85C \uC801\uC744 \uACF5\uACA9 \uD569\uB2C8\uB2E4"
    _en: Attacks enemies with arrows
    _ja: "\u77E2\u3067\u6575\u3092\u653B\u6483\u3057\u307E\u3059"
    _de: Greift Gegner mit Pfeilen an
    _tw: "\u4F7F\u7528\u7BAD\u77E2\u653B\u64CA\u6575\u4EBA"
    _ru: "\u0410\u0442\u0430\u043A\u0443\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432
      \u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438"

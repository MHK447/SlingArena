    _vi: "M\xE1u t\u1ED1i \u0111a t\u0103ng <color=#37B700>+{0}%</color>."
  - _idx: str_upgrade_choice_desc_9
    _ko: "\uC8FC\uC0AC\uC704 +{0} \uCD94\uAC00 \uC0DD\uC131"

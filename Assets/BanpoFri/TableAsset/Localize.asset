      <color=#37B700>+{0}</color>."
  - _idx: str_upgrade_choice_desc_2
    _ko: "\uACF5\uACA9\uB825 <color=#37B700>+{0}%</color> \uC99D\uAC00 \uD569\uB2C8\uB2E4."

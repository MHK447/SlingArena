    _ja: "\u77E2\u304C{0}\u56DE\u8DF3\u306D\u8FD4\u308A\u307E\u3059\u3002"
    _de: Pfeile prallen {0} Mal ab.
    _tw: "\u7BAD\u77E2\u5F48\u8DF3{0}\u6B21\u3002"
    _ru: "\u0421\u0442\u0440\u0435\u043B\u044B \u043E\u0442\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u044E\u0442
      {0} \u0440\u0430\u0437."

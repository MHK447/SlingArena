    _ja: "<color=#00FF00>{0}</color>\u79D2\u3054\u3068\u306B\u6575\u3092\u51CD\u3089\u305B\u308B\u30A2\u30A4\u30B9\u30AA\u30FC\u30D6\u3092\u751F\u6210\u3057\u307E\u3059\u3002"

    _vi: "Th\xEAm +<color=#37B700>{0}</color> x\xFAc x\u1EAFc t\u1EA5n c\xF4ng\\n\u0110\xE3
      th\xEAm v\xE0o danh s\xE1ch xu\u1EA5t hi\u1EC7n"
  - _idx: str_levelup_dice_desc_7_2
    _ko: "\uC8FC\uC0AC\uC704 \uACF5\uACA9\uB825 +<color=#37B700>{0}%</color>"
    _en: Dice attack increased by <color=#37B700>{0}%</color>.
    _ja: "\u30B5\u30A4\u30B3\u30ED\u653B\u6483\u529B\u304C<color=#37B700>{0}%</color>\u5897\u52A0\u3057\u307E\u3059\u3002"

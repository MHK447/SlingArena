  - _idx: str_levelup_dice_desc_8_2
    _ko: "\uC8FC\uC0AC\uC704 \uD53C\uD574\uB7C9 +<color=#37B700>{0}%</color>"
    _en: Dice damage increased by <color=#37B700>{0}%</color>.
    _ja: "\u30B5\u30A4\u30B3\u30ED\u30C0\u30E1\u30FC\u30B8\u304C<color=#37B700>{0}%</color>\u5897\u52A0\u3057\u307E\u3059\u3002"

    _ko: "\uACF5\uACA9\uB825 \uC99D\uAC00"
    _en: Increase Attack
    _ja: "\u653B\u6483\u529B\u5897\u52A0"
    _de: "Angriff erh\xF6hen"
    _tw: "\u589E\u52A0\u653B\u64CA\u529B"
